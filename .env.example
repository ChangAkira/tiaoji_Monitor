# 接收通知的 QQ 号
TARGET_QQ=你的接收QQ号

# NapCatQQ 所在机器地址。与脚本同机就填 127.0.0.1（留空也是这个默认值），
# 机器人跑在别的机器上才填公网/内网 IP
SERVER_IP=127.0.0.1

# NapCatQQ 的 OneBot11 HTTP 服务端口（默认 3000）。
# 变量名里的 LANGBOT 是历史遗留：这条推送链路跟 LangBot 框架无关，只是 NapCat 自己的端口
LANGBOT_PORT=3000

# NapCatQQ HTTP 服务的 access token。WebUI 里设了才填，没设就留空（留空则不带鉴权头）
# 已设的话可在 napcat/config/onebot11_<机器人QQ号>.json 的 network.httpServers[0].token 查到
NAPCAT_TOKEN=
